# 📌 Dockerfile for Testing Environment with PostgreSQL Support
# Optimized for Docker layer caching in CI/CD
FROM python:3.10-slim

# 🏷️ Add labels for better cache management
LABEL org.opencontainers.image.source="https://github.com/sni10/new_autotrade"
LABEL org.opencontainers.image.description="AutoTrade Test Runner with PostgreSQL and TA-Lib"

# 🧰 Install system dependencies (cached layer - changes rarely)
RUN apt-get update && apt-get install -y \
    build-essential \
    wget \
    curl \
    gcc \
    make \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

# 🧱 Install TA-Lib from source (heavy operation - cached layer)
RUN wget https://github.com/TA-Lib/ta-lib/releases/download/v0.6.4/ta-lib-0.6.4-src.tar.gz && \
    tar -xzf ta-lib-0.6.4-src.tar.gz && \
    cd ta-lib-0.6.4 && \
    ./configure --prefix=/usr && \
    make && \
    make install && \
    cd .. && \
    rm -rf ta-lib-0.6.4 ta-lib-0.6.4-src.tar.gz

# 📁 Set up working directory
WORKDIR /app

# 🔧 Install Python dependencies (separate layer for better caching)
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir pytest-cov pytest-xdist

# 🧪 Create directories and inline entrypoint script
RUN mkdir -p /app/src/config && \
    echo '#!/bin/bash' > /app/entrypoint.sh && \
    echo 'set -e' >> /app/entrypoint.sh && \
    echo 'echo "🔧 AutoTrade Test Container Starting..."' >> /app/entrypoint.sh && \
    echo 'if [ -n "$DB_HOST" ]; then' >> /app/entrypoint.sh && \
    echo '    echo "🔧 Updating database host to: $DB_HOST"' >> /app/entrypoint.sh && \
    echo '    sed -i "s/\"host\": \"localhost\"/\"host\": \"$DB_HOST\"/" /app/src/config/config.json' >> /app/entrypoint.sh && \
    echo 'fi' >> /app/entrypoint.sh && \
    echo 'if [ -n "$DB_PORT" ]; then' >> /app/entrypoint.sh && \
    echo '    echo "🔧 Updating database port to: $DB_PORT"' >> /app/entrypoint.sh && \
    echo '    sed -i "s/\"port\": 5434/\"port\": $DB_PORT/" /app/src/config/config.json' >> /app/entrypoint.sh && \
    echo 'fi' >> /app/entrypoint.sh && \
    echo 'if [ -n "$DB_USER" ]; then' >> /app/entrypoint.sh && \
    echo '    echo "🔧 Updating database user to: $DB_USER"' >> /app/entrypoint.sh && \
    echo '    sed -i "s/\"user\": \".*\"/\"user\": \"$DB_USER\"/" /app/src/config/config.json' >> /app/entrypoint.sh && \
    echo 'fi' >> /app/entrypoint.sh && \
    echo 'if [ -n "$DB_PASSWORD" ]; then' >> /app/entrypoint.sh && \
    echo '    echo "🔧 Updating database password"' >> /app/entrypoint.sh && \
    echo '    sed -i "s/\"password\": \".*\"/\"password\": \"$DB_PASSWORD\"/" /app/src/config/config.json' >> /app/entrypoint.sh && \
    echo 'fi' >> /app/entrypoint.sh && \
    echo 'if [ -n "$DB_NAME" ]; then' >> /app/entrypoint.sh && \
    echo '    echo "🔧 Updating database name to: $DB_NAME"' >> /app/entrypoint.sh && \
    echo '    sed -i "s/\"database\": \".*\"/\"database\": \"$DB_NAME\"/" /app/src/config/config.json' >> /app/entrypoint.sh && \
    echo 'fi' >> /app/entrypoint.sh && \
    echo 'if [ -n "$DB_HOST" ] && [ -n "$DB_PORT" ]; then' >> /app/entrypoint.sh && \
    echo '    echo "🔧 Waiting for PostgreSQL at $DB_HOST:$DB_PORT..."' >> /app/entrypoint.sh && \
    echo '    until pg_isready -h "$DB_HOST" -p "$DB_PORT" -U "$DB_USER" -d "$DB_NAME"; do' >> /app/entrypoint.sh && \
    echo '        echo "⏳ PostgreSQL is unavailable - sleeping"' >> /app/entrypoint.sh && \
    echo '        sleep 2' >> /app/entrypoint.sh && \
    echo '    done' >> /app/entrypoint.sh && \
    echo '    echo "✅ PostgreSQL is ready!"' >> /app/entrypoint.sh && \
    echo 'fi' >> /app/entrypoint.sh && \
    echo 'echo "🚀 Container ready - executing command: $@"' >> /app/entrypoint.sh && \
    echo 'exec "$@"' >> /app/entrypoint.sh && \
    chmod +x /app/entrypoint.sh

# 🔧 Copy configuration files
COPY src/config/config.json /app/src/config/config.json

# 🧪 Set environment variables for testing
ENV PYTHONPATH=/app
ENV PYTEST_CURRENT_TEST=1
ENV PYTHONUNBUFFERED=1

# 🚀 Use inline entrypoint script
ENTRYPOINT ["/app/entrypoint.sh"]

# 📋 Default command - will be overridden by docker-compose
CMD ["echo", "🐳 AutoTrade test container ready"]
